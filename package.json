{
  "name": "discord-memory-bot",
  "version": "1.0.0",
  "description": "Bot de Discord con IA (Groq) y memoria persistente por usuario (Supabase) — TypeScript",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "clear-global-commands": "tsx src/clear-global-commands.ts",
    "setup": "npm-run-all build deploy-commands dev"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "groq-sdk": "^0.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^20.14.15",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "wrangler": "^4.120.0"
  }
}
